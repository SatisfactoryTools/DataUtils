#!/usr/bin/env php
<?php declare(strict_types = 1);

use SFTools\Data\Commands\ParseCommand;
use Symfony\Component\Console\Application;

// resolves both a repository checkout and an installation as a composer dependency
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
	if (file_exists($autoload)) {
		require $autoload;
		break;
	}
}

if (!class_exists(Application::class)) {
	fwrite(STDERR, 'Could not find composer autoloader. Run `composer install` first.' . PHP_EOL);
	exit(1);
}

$application = new Application('Satisfactory Data Parser', '1.0.0');
$application->addCommand(new ParseCommand());
$application->run();
